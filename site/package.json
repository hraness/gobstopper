{
  "name": "gobstopper-site",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "check:theme": "bun scripts/check-paper-theme.mjs",
    "sync:readme": "bun scripts/sync-readme.ts",
    "sync:blog": "bun scripts/sync-blog.ts",
    "dev": "bun run sync:readme && bun run sync:blog && bun run build:theme && next dev --webpack",
    "prebuild": "bun run sync:readme && bun run sync:blog && bun run build:theme",
    "build": "next build --webpack",
    "postbuild": "bun test ./tests/runtime.test.ts",
    "start": "next start",
    "lint": "eslint . --ignore-pattern .next",
    "test": "bun test ./tests/source.test.ts ./tests/home.test.tsx ./tests/compare.test.tsx ./scripts/readme-html.test.ts ./tests/ui-styles.test.tsx ./tests/blog.test.tsx",
    "typecheck": "tsc --noEmit",
    "check": "bun run check:theme && bun run sync:readme && bun run sync:blog && bun run test && bun run lint && bun run typecheck && bun run build",
    "build:theme": "bun scripts/build-theme-bootstrap.ts"
  },
  "dependencies": {
    "@hraness/design-kit": "github:hraness/design-kit#v0.19.0",
    "@hraness/site-footer": "github:hraness/site-footer#v0.19.0",
    "@hraness/ui": "github:hraness/ui#v0.5.18",
    "@hraness/web-discovery": "github:hraness/web-discovery#v0.8.0",
    "next": "16.3.3",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/bun": "1.3.14",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "4.2.1",
    "typescript": "6.0.3",
    "postcss": "8.5.28"
  },
  "type": "module"
}
